---
import Layout from '../../layouts/Layout.astro';
import ContactBand from '../../components/ContactBand.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import PhotoViewer from '../../components/PhotoViewer.astro';
import { projects,services } from '../../data/content';
export function getStaticPaths(){return projects.map(project=>({params:{slug:project.slug},props:{project}}));}
const { project }=Astro.props;
const related=projects.filter(p=>p.slug!==project.slug&&p.category===project.category).slice(0,2);
const service=services.find(s=>s.slug===project.service)!;
---
<Layout title={`${project.title} — project | Heikoop Bouw`} description={project.intro}>
  <div class="container breadcrumb"><a href="/projecten/">Projecten</a><span aria-hidden="true">/</span><span>{project.title}</span></div>
  <div class="container project-title"><p class="eyebrow">{project.label}</p><h1>{project.title}</h1><p>{project.intro}</p></div>
  <div class="container project-cover"><a class="photo-trigger" href={`/assets/${project.image}`} data-photo-index="0" aria-label={`Bekijk foto van ${project.title} op groot formaat`}><img src={`/assets/${project.image}`} alt={project.alt} width="960" height="720" fetchpriority="high"/><span class="photo-hint"><span aria-hidden="true">⤢</span> Bekijk op groot formaat</span></a></div>
  <section class="section container project-story"><aside><div><span>WERKZAAMHEDEN</span><p>{project.work}</p></div><div><span>MATERIAAL / AFWERKING</span><p>{project.material}</p></div><a class="text-link" href={`/diensten/${project.service}/`}>Meer over {service.title.toLowerCase()} <span aria-hidden="true">↗</span></a></aside><div class="prose"><p class="eyebrow">HET PROJECT</p><h2>Aandacht voor<br/>wat u ziet én gebruikt.</h2><p>{project.detail}</p><h3>Het resultaat</h3><p>{project.result}</p><a class="button" href={`/contact/?project=${project.slug}`}>Ik heb vergelijkbare plannen <span aria-hidden="true">↗</span></a></div></section>
  {project.images.length>1&&<section class="container gallery" aria-label="Meer projectfoto’s">{project.images.slice(1).map((file,i)=><figure><a class="photo-trigger" href={`/assets/${file}`} data-photo-index={i+1} aria-label={`Bekijk foto ${i+2} van ${project.title} op groot formaat`}><img src={`/assets/${file}`} alt={`${project.alt}, aanzicht ${i+2}`} width="960" height="720" loading="lazy"/><span class="photo-hint"><span aria-hidden="true">⤢</span> Bekijk op groot formaat</span></a><figcaption>Een ander aanzicht van de veranda.</figcaption></figure>)}</section>}
  {related.length>0&&<section class="section container"><div class="section-heading"><div><p class="eyebrow">MEER WERK BEKIJKEN</p><h2>Ook gemaakt door Heikoop.</h2></div><a class="text-link" href="/projecten/">Alle projecten ↗</a></div><div class="project-grid two">{related.map(p=><ProjectCard project={p}/>)}</div></section>}
  <ContactBand/>
  <PhotoViewer title={project.title} images={project.images} alt={project.alt}/>
</Layout>
