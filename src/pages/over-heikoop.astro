import Layout from '../layouts/Layout.astro';
import ContactBand from '../components/ContactBand.astro';
---
<Layout title="Over Patrick Heikoop | Heikoop Bouw" description="Maak kennis met Patrick Heikoop. Heikoop Bouw is opgericht in 2017 en werkt aan nieuwbouw, uitbreidingen, renovatie en timmerwerk.">
  <section class="container about-hero"><div><p class="eyebrow">OVER HEIKOOP BOUW</p><h1>Aangenaam.<br/>Patrick Heikoop.</h1><p class="lead">Een bouwplan wordt persoonlijk zodra het over uw huis gaat. Dan is het prettig om te weten met wie u werkt.</p><p>Ik ben Patrick Heikoop. In 2017 richtte ik Heikoop Bouw op. Vanuit De Meern werk ik aan bouw- en timmerprojecten voor particulieren en bedrijven.</p><a class="text-link" href="/contact/">Laten we kennismaken <span aria-hidden="true">↗</span></a></div><figure><img src="/assets/patrick.jpg" alt="Patrick Heikoop" width="800" height="595" fetchpriority="high"/><figcaption>Patrick Heikoop · oprichter Heikoop Bouw</figcaption></figure></section>
  <section class="section soft"><div class="container content-columns"><div><p class="eyebrow">VAKMANSCHAP ALS BASIS</p><h2>Opgegroeid<br/>met het bouwen.</h2></div><div class="prose"><p>Het vak leerde Patrick in de praktijk, onder andere in het bouwbedrijf van zijn vader Chris. Met een achtergrond in MTS Bouwkunde en bouwkundig tekenen kent hij zowel de uitvoering als de voorbereiding.</p><p>Zijn ervaring omvat timmerwerk, werkvoorbereiding, calculatie en tekenwerk. Die combinatie vormt de basis voor Heikoop Bouw: van een eerste bouwplan tot het werk op locatie.</p><p>Heikoop Bouw richt zich op nieuwbouw, uitbreidingen en renovaties. Het portfolio laat daarnaast dakkapellen, veranda’s, meubels en trapwerk zien.</p></div></div></section>
  <section class="section container"><div class="section-heading"><div><p class="eyebrow">SAMEN VOORUITKIJKEN</p><h2>Een goed gesprek<br/>legt de basis.</h2></div><p>Bij uw plannen horen praktische vragen. Door die vroeg te bespreken, wordt duidelijk wat uw project vraagt.</p></div><div class="process-grid"><article><span>01</span><h3>Uw idee</h3><p>Wat wilt u veranderen? Vertel over uw wensen, de ruimte en het gebruik.</p></article><article><span>02</span><h3>De mogelijkheden</h3><p>Bespreek de bestaande situatie, materiaalkeuzes en de voorbereiding die nodig is.</p></article><article><span>03</span><h3>De afspraken</h3><p>Maak werkzaamheden, afwerking en planning concreet voordat de uitvoering begint.</p></article></div></section>
  <ContactBand/>
</Layout>
